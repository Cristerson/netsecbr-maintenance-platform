{
  "name": "netsecbr-maintenance-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode staging",
    "dev:staging": "vite --mode staging",
    "dev:production": "vite --mode production",
    "test:e2e": "playwright test",
    "build": "npm run build:staging",
    "build:staging": "tsc -b && vite build --mode staging",
    "build:production": "tsc -b && vite build --mode production",
    "package:production": "npm run build:production && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-production.ps1",
    "preview": "vite preview --mode staging --outDir dist/staging",
    "preview:production": "vite preview --mode production --outDir dist/production"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
